#!/usr/bin/env bash

# ─────────────────────────────────────────
#  Mythe - Terminal Task Manager
#  Version 0.1.0
# ─────────────────────────────────────────

# Resolve symlink op macOS
MYTHE_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$MYTHE_SOURCE" ]; do
  MYTHE_SOURCE="$(readlink "$MYTHE_SOURCE")"
done
MYTHE_DIR="$(cd "$(dirname "$MYTHE_SOURCE")" && pwd)"
COMMANDS_DIR="$MYTHE_DIR/commands"
CONFIG_FILE="$MYTHE_DIR/config.sh"

# Load config
source "$CONFIG_FILE"

# No command given → show help
if [ -z "$1" ]; then
  source "$COMMANDS_DIR/help.sh"
  exit 0
fi



COMMAND="$1"
shift

case "$COMMAND" in
  install)   source "$COMMANDS_DIR/install.sh" "$@" ;;
  run)       source "$COMMANDS_DIR/run.sh" "$@" ;;
  list)      source "$COMMANDS_DIR/list.sh" "$@" ;;
  add)       source "$COMMANDS_DIR/add.sh" "$@" ;;
  remove)    source "$COMMANDS_DIR/remove.sh" "$@" ;;
  help|--help|-h) source "$COMMANDS_DIR/help.sh" ;;
  version|--version|-v) echo "Mythe versie $MYTHE_VERSION" ;;
  *)
    echo "❌ Unknown command: '$COMMAND'"
    echo "   Type 'mythe help' for an overview."
    exit 1
    ;;
esac
